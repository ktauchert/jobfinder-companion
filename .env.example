# ------------------------------------------------------------------------------
# JobFinder – environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored.
# Docker Compose reads this file for the infrastructure containers, and the
# apps read it for connecting to them.
# ------------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (pgvector/pgvector:pg16) --------------------------------------
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder

# --- Redis (BullMQ queues, rate limiting, SSE pub/sub) ------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Ollama (local AI) --------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model: 768-dimensional vectors. Changing this requires re-embedding
# all jobs and updating the vector column dimension.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Skill-extraction model (structured JSON output).
OLLAMA_EXTRACT_MODEL=qwen2.5:3b

# --- API (apps/api) -----------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# --- Web (apps/web) -----------------------------------------------------------
WEB_PORT=5173
# Vite only exposes VITE_-prefixed vars to the browser.
VITE_API_BASE_URL=http://localhost:3000

# --- Job sources: FREE / OPEN tier (no key required) --------------------------
# Bundesagentur für Arbeit Jobsuche API. Uses a public client id; override only
# if the public one stops working.
BA_CLIENT_ID=jobboerse-jobsuche
# Greenhouse / Lever: public board endpoints, configured per company slug in
# the sources table – no env needed.

# --- Job sources: PAID / KEY-REQUIRED tier ------------------------------------
# Leave empty to disable a source. The API marks it as "not configured" and the
# UI greys it out.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
APIFY_TOKEN=

# --- Caddy reverse proxy (only with `docker compose --profile proxy`) ---------
CADDY_DOMAIN=localhost
