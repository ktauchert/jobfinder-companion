{
  "name": "jobfinder-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, keyboard-first job matching engine for developers. Ingests jobs in the background, extracts skills and embeddings with Ollama, and searches them with PostgreSQL + pgvector.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ktauchert/jobfinder-companion.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:quality": "npm run format:check && turbo run lint typecheck test && npm run build",
    "check:integration": "npm run db:migrate && npm run db:seed && npm run test:integration",
    "check": "npm run check:quality && npm run check:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "infra:up": "docker compose up -d",
    "infra:up:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d",
    "infra:down": "docker compose down",
    "infra:down:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml down",
    "infra:logs": "docker compose logs -f",
    "infra:logs:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml logs -f",
    "infra:reset": "docker compose down -v",
    "infra:reset:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml down -v",
    "db:generate": "npm run generate -w @jobfinder/database",
    "db:migrate": "npm run migrate -w @jobfinder/database",
    "db:seed": "npm run seed -w @jobfinder/database",
    "db:studio": "npm run studio -w @jobfinder/database",
    "test:integration": "npm run test:integration -w @jobfinder/api"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  }
}
