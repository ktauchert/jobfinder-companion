{
  "name": "@jobfinder/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types for JobFinder: jobs, profiles, sources, ingestion status, API contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@jobfinder/config": "*",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  }
}
