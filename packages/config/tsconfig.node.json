{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "declaration": false,
    "declarationMap": false
  }
}
